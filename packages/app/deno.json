{
  "name": "@openelement/app",
  "version": "0.42.0-alpha.8",
  "exports": {
    ".": "./src/index.ts",
    "./hono": "./src/hono.ts",
    "./model": "./src/model.ts",
    "./spa": "./src/spa.ts",
    "./i18n": "./src/i18n.ts",
    "./preact": "./src/preact.ts"
  },
  "imports": {
    "preact-render-to-string": "npm:preact-render-to-string@^6.5.0"
  },
  "publish": {
    "include": [
      "src/**",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "tasks": {
    "build": "deno check src/",
    "test": "deno test -A",
    "lint": "deno lint src/ __tests__/",
    "typecheck": "deno check src/"
  },
  "peerDependencies": {
    "preact": "npm:preact@^10.28.0",
    "preact-render-to-string": "npm:preact-render-to-string@^6.5.0"
  }
}
