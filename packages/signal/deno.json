{
  "name": "@openelement/signal",
  "version": "0.41.0-alpha.8",
  "exports": {
    ".": "./src/index.ts",
    "./framework": "./src/framework.ts"
  },
  "imports": {
    "@preact/signals-core": "npm:@preact/signals-core@^1.12.1"
  },
  "publish": {
    "include": [
      "src/**",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "tasks": {
    "build": "deno check src/index.ts"
  }
}
