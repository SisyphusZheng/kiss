{
  "name": "@openelement/content",
  "version": "0.41.0-alpha1",
  "//": "content is an engine-layer Vite plugin, not runtime-free",
  "exports": {
    ".": "./src/index.ts",
    "./blog-data": "./src/blog/blog-data.ts",
    "./mdx": "./src/mdx/compile.ts",
    "./nav": "./src/nav/scanner.ts",
    "./sitemap": "./src/sitemap/generator.ts",
    "./write-json": "./src/write-json.ts"
  },
  "imports": {
    "marked": "npm:marked@^15",
    "gray-matter": "npm:gray-matter@^4.0.3",
    "@mdx-js/mdx": "npm:@mdx-js/mdx@^3.1.1",
    "sanitize-html": "npm:sanitize-html@^2.17.4",
    "@types/sanitize-html": "npm:@types/sanitize-html@^2",
    "vite": "npm:vite@8.0.10"
  },
  "publish": {
    "include": [
      "src/**",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ],
  "tasks": {
    "build": "deno check src/index.ts"
  }
}
