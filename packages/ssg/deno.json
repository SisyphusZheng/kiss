{
  "name": "@openelement/ssg",
  "version": "0.40.8",
  "exports": {
    ".": "./src/index.ts"
  },
  "imports": {
    "hono": "npm:hono@^4.12",
    "typescript": "npm:typescript@^5.9.0"
  },
  "tasks": {
    "build": "deno check src/index.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net __tests__/"
  },
  "publish": {
    "include": [
      "src/**",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
