{
  "name": "@openelement/ssg",
  "version": "0.41.0-alpha.6",
  "exports": {
    ".": "./src/index.ts",
    "./drivers": "./src/drivers.ts"
  },
  "tasks": {
    "build": "deno check src/index.ts",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net __tests__/"
  },
  "publish": {
    "include": [
      "src/**",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
