{
  "name": "@openelement/adapter-vite",
  "version": "0.41.2",
  "exports": {
    ".": "./src/index.ts",
    "./nitro-mount": "./src/nitro-mount.ts",
    "./sitemap": "./src/sitemap.ts",
    "./cli/build": "./src/cli/build.ts"
  },
  "imports": {
    "@mdx-js/rollup": "npm:@mdx-js/rollup@^3.1.1",
    "@hono/vite-dev-server": "npm:@hono/vite-dev-server@^0.25.3",
    "gray-matter": "npm:gray-matter@^4.0.3",
    "marked": "npm:marked@^15.0.0",
    "sanitize-html": "npm:sanitize-html@^2.17.4",
    "@types/sanitize-html": "npm:@types/sanitize-html@^2",
    "hono": "npm:hono@^4.12",
    "vite": "npm:vite@8.0.16"
  },
  "tasks": {
    "build": "deno check src/",
    "test": "deno test --allow-read --allow-write --allow-env --allow-net __tests__/"
  },
  "publish": {
    "include": [
      "src/**",
      "deno.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "src/**/__tests__/**",
      "__tests__/**",
      "__fixtures__/**"
    ]
  },
  "include": [
    "src"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
