{
  "name": "@openelement/example-desktop-reader",
  "version": "0.41.0-alpha.5",
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno task build:client && deno run -A main.ts",
    "build": "deno task build:client && deno desktop main.ts",
    "build:client": "deno run -A build-client.ts",
    "check": "deno check main.ts",
    "smoke": "deno test -A --no-check app/__tests__/"
  },
  "imports": {
    "pdf-parse": "npm:pdf-parse@^1.1.1",
    "esbuild": "npm:esbuild@^0.25.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "@openelement/core",
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"]
  },
  "desktop": {
    "backend": "webview",
    "title": "openElement Reader",
    "width": 1200,
    "height": 800
  }
}
