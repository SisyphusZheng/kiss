{
  "schemaVersion": 1,
  "purpose": "Executable v0.44 three-role executor configuration. Documentation under docs/ refers only to the role labels thinker, implementer and release verifier; exact local executor identity and role-profile paths live here, outside docs/.",
  "thinker": {
    "role": "thinker",
    "model": "gpt-5.6-sol",
    "reasoningEffort": "low"
  },
  "executor": {
    "command": "kimi",
    "provider": "managed:kimi-code",
    "model": "k3-256k",
    "modelAlias": "kimi-code/k3-256k",
    "contextTokens": 262144,
    "defaultEffort": "high",
    "requiredCapabilities": ["thinking", "tool_use"]
  },
  "profiles": {
    "implementer": {
      "agentFile": ".agents/v044-kimi-implementer.md",
      "smokeMarker": "V044_IMPLEMENTER_PROFILE_OK",
      "sessionPolicy": "fresh-per-packet-resume-same-role-on-repair"
    },
    "releaseVerifier": {
      "agentFile": ".agents/v044-kimi-release-verifier.md",
      "smokeMarker": "V044_RELEASE_VERIFIER_PROFILE_OK",
      "sessionPolicy": "fresh-per-candidate-sha"
    }
  },
  "roleRunnerTask": "v044:role",
  "prohibitedDocIdentifiers": {
    "literals": ["kimi-code", "kimicode", "k3-256k", "moonshot", "gpt-5.6"],
    "tokens": [
      "kimi",
      "k3",
      "sol",
      "codex",
      "gpt",
      "openai",
      "opencode",
      "claude",
      "anthropic",
      "deepseek",
      "qwen",
      "gemini"
    ]
  }
}
