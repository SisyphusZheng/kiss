{
  "$schema": "https://raw.githubusercontent.com/webcomponents/custom-elements-manifest/main/schema.json",
  "schemaVersion": "1.0.0",
  "modules": [
    {
      "kind": "javascript-module",
      "path": "./native.ts",
      "declarations": [
        {
          "kind": "class",
          "name": "V044NativeProbe",
          "customElement": true,
          "tagName": "v044-native-probe",
          "superclass": { "name": "HTMLElement" },
          "members": [
            {
              "kind": "field",
              "name": "value",
              "type": { "text": "string" },
              "attribute": "value",
              "reflect": true
            }
          ],
          "events": [{ "name": "v044-probe-event" }],
          "slots": [{ "name": "", "description": "Default content slot" }],
          "cssParts": [{ "name": "control" }]
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "./lit.ts",
      "declarations": [
        {
          "kind": "class",
          "name": "V044LitProbe",
          "customElement": true,
          "tagName": "v044-lit-probe",
          "superclass": { "name": "LitElement" },
          "members": [
            {
              "kind": "field",
              "name": "value",
              "type": { "text": "string" },
              "attribute": "value",
              "reflect": true
            }
          ],
          "events": [{ "name": "v044-probe-event" }],
          "slots": [{ "name": "", "description": "Default content slot" }],
          "cssParts": [{ "name": "control" }]
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "./fast.ts",
      "declarations": [
        {
          "kind": "class",
          "name": "V044FastProbe",
          "customElement": true,
          "tagName": "v044-fast-probe",
          "superclass": { "name": "FASTElement" },
          "members": [
            {
              "kind": "field",
              "name": "value",
              "type": { "text": "string" },
              "attribute": "value",
              "reflect": true
            }
          ],
          "events": [{ "name": "v044-probe-event" }],
          "slots": [{ "name": "", "description": "Default content slot" }],
          "cssParts": [{ "name": "control" }]
        }
      ]
    },
    {
      "kind": "javascript-module",
      "path": "./stencil.ts",
      "declarations": [
        {
          "kind": "class",
          "name": "V044StencilProbe",
          "customElement": true,
          "tagName": "v044-stencil-probe",
          "superclass": { "name": "IonButton" },
          "members": [
            {
              "kind": "field",
              "name": "disabled",
              "type": { "text": "boolean" },
              "attribute": "disabled",
              "reflect": true
            }
          ],
          "events": [{ "name": "click" }],
          "slots": [{ "name": "", "description": "Default content slot" }],
          "cssParts": [{ "name": "native" }]
        }
      ]
    }
  ]
}
