# Dependencies
node_modules/

# Deno
.deno/
vendor/*
# Keep vendored dependency attribution tracked for license compliance
!vendor/jsr.io/
!vendor/jsr.io/@std/
!vendor/jsr.io/@std/LICENSE
!vendor/jsr.io/@std/ATTRIBUTION.md
# Deno materializes JSR sources during a frozen install. Keep only license
# attribution under each module; generated source/version metadata is cache.
vendor/jsr.io/@std/*
!vendor/jsr.io/@std/*/
vendor/jsr.io/@std/*/*
!vendor/jsr.io/@std/*/LICENSE

# Build output
dist/
custom-dist/
npm/
packages/adapter-vite/__fixtures__/nitro-proof/.output-*/
packages/adapter-vite/__fixtures__/nitro-proof/.wrangler/
packages/adapter-vite/__fixtures__/nitro-proof/.nitro/
packages/adapter-vite/__fixtures__/nitro-proof/node_modules/
*.tsbuildinfo
.tsbuildinfo
www/app/data/_generated-blog-data.ts

# npm (Deno project - no npm lockfiles)
package-lock.json

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Testing
coverage/
.coverage/
.coverage-check/
__test_fixtures__/
playwright-report/
test-results/

# Framework internals
.workbuddy/
.gstack/
.qoder/
docs/autoflow/cells/*/state.json

# Vite cache
.vite/
/.wrangler/

# Generated www data modules and the UI manifest are intentionally tracked.
# repo:hygiene fails if a tracked file also matches .gitignore.

# Test / build / lint / coverage output files
test-*.txt
cov-*.txt
ui-test*.txt
lint-*.txt
coverage-*.txt
coverage-output.txt
.git-commit-msg.txt
docs/vite-build-*.txt
node_modules/

# npm pack tarballs
packages/*/*.tgz
*.tgz

# Root-level logo source files (design originals, keep local)
/open-logo*.svg
/open-favicon.svg
/brand/exports/

www/dist/
dist/
custom-dist/
dist-test-ssg-render/
dist-test-ssg-package-render/
dist-test-*/
coverage/
playwright-report/
test-results/
debug.log
hub-index/
hub-submission.json

deliverables/
lighthouse-result*.json
.deno-cache/
.deno_cache/
www/.openElement/
.openElement/
.codebuddy/settings.local.json

